# Base44 — VITE_BASE44_APP_ID é obrigatório
VITE_BASE44_APP_ID=6a0d05aa26af897b0567e927

# Opcional: URL do backend Base44. Se omitido, o app usa window.location.origin
# em runtime — funciona out-of-the-box quando hospedado em *.base44.app. Defina
# explicitamente apenas quando o front estiver num domínio próprio (Hostinger,
# Netlify, etc.) e precisar bater no backend separado.
# VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Opcional: força uma versão específica das functions do Base44
# VITE_BASE44_FUNCTIONS_VERSION=
